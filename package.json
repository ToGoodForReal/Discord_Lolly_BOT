{
  "name": "lolly",
  "version": "2.0.0",
  "description": "Lolly — Discord bot multiuso com música, jogos e diversão",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --no-warnings --loader ts-node/esm src/index.ts",
    "start": "node --no-warnings dist/index.js",
    "reg": "node --no-warnings --loader ts-node/esm src/lib/command-registry.ts",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elitinho123456/Discord_Lolly_BOT.git"
  },
  "author": "Elitinho123456",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Elitinho123456/Discord_Lolly_BOT/issues"
  },
  "homepage": "https://github.com/Elitinho123456/Discord_Lolly_BOT#readme",
  "dependencies": {
    "@discord-player/extractor": "^7.1.0",
    "@snazzah/davey": "^0.1.12",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "^2.0.0",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.2.0",
    "opusscript": "^0.1.1",
    "youtube-dl-exec": "^3.1.11"
  },
  "overrides": {
    "undici": "^6.21.1",
    "esbuild": "^0.28.1",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "ffmpeg-static@*": true,
    "esbuild@*": true,
    "youtube-dl-exec@*": true
  }
}
